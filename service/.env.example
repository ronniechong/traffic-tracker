# Copy to .env and fill in — .env is gitignored, never commit real values.

# VIC open data portal subscription key. Sent as the "KeyId" header.
VIC_TRAFFIC_API_SUBSCRIPTION_KEY=

# External dead-man's-switch ping URL for the poller loop. Pinged once per
# fully successful poll cycle. Optional — unset means the ping is silently
# skipped, never blocks the poller.
TT_DEADMAN_PING_URL=

# The single frontend origin allowed by the API's CORS policy — no wildcard.
# Must be set to the real deployed frontend origin.
FRONTEND_ORIGIN=https://ronniechong.com

# Host/port the API binds to. Defaults to 127.0.0.1:8000 (localhost-only) —
# only override if you know a reverse proxy is fronting it.
TT_API_HOST=
TT_API_PORT=
