# Copy to .env.local (gitignored) and set to the deployed API's base URL.
# This ships in the built client bundle regardless (any visitor's browser
# calls it directly), so it is a public build-time value, not a secret.
VITE_API_BASE_URL=

# Dev-only, optional. The deployed API's CORS policy only allows the
# production frontend origin, so a plain `npm run dev` against
# VITE_API_BASE_URL above gets blocked by the browser. Setting this to the
# deployed API's URL routes requests through Vite's own dev-server proxy
# instead (see vite.config.ts) -- a same-origin request from the browser's
# point of view, so CORS never applies. Leave VITE_API_BASE_URL above set
# to "." when using this, so requests go to Vite's own origin. Unused in
# the production build.
VITE_DEV_API_PROXY_TARGET=
