# Copy to .env and fill in -- .env is gitignored, never commit real values.

# VIC open data portal subscription key. Sent as the "KeyId" header.
VIC_TRAFFIC_API_SUBSCRIPTION_KEY=

# External dead-man's-switch ping URL for the poller loop. Optional --
# unset means the ping is silently skipped, never blocks the poller.
TT_DEADMAN_PING_URL=

# The single frontend origin allowed by the API's CORS policy -- no
# wildcard. Set it to the real deployed frontend origin.
FRONTEND_ORIGIN=https://ronniechong.com

# Tailscale auth key for the tunnel sidecar, and the node hostname it
# registers under.
TS_AUTHKEY=
TS_HOSTNAME=traffic-tracker

# Host directory bind-mounted into both containers as the shared data
# volume (poller: read-write, api: read-only).
TT_DATA_DIR=./data
